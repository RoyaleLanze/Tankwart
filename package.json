  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "format": "prettier --write .",
    "gen:types": "supabase gen types typescript > src/lib/database.types.ts && prettier --write src/lib/database.types.ts"
