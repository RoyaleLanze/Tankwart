# Kopieren nach .env (wird nicht versioniert). Beide Werte sind öffentlich (Client-Konfiguration).
#
# Lokal (npx supabase start): Werte aus `npx supabase status`.
#   Android-Emulator erreicht den Host über 10.0.2.2 statt 127.0.0.1.
# Cloud: Supabase-Dashboard → Project Settings → API Keys.
EXPO_PUBLIC_SUPABASE_URL=http://10.0.2.2:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
