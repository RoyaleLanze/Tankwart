# Copy to supabase/functions/.env for local development (not versioned).
# Cloud: npx supabase secrets set TANKERKOENIG_API_KEY=... (never commit the key).
#
# true: fixed sample prices, no API key and no Tankerkönig request needed.
PRICES_MOCK=true
# Only needed with PRICES_MOCK=false. Free key: https://creativecommons.tankerkoenig.de
TANKERKOENIG_API_KEY=
